# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Project artifacts (tracked intentionally via .gitkeep in their dirs)
models/*.joblib
outputs/*.json
outputs/*.csv
outputs/*.png
experiments/EXP-*/

# Dataset files (large)
data/*.csv
data/*.pcap
data/*.pcap.gz
data/*.zip
data/extracted/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# Streamlit
.streamlit/secrets.toml

# Pytest
.pytest_cache/
